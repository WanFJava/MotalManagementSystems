        <mxCell id="rel_room_status" value="uses" style="endArrow=open;dashed=1;html=1;endFill=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cls_entity_room" target="cls_enum_status">

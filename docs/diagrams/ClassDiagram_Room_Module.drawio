        <mxCell id="rel_ctrl_srv" value="delegates to" style="endArrow=open;dashed=1;html=1;endFill=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cls_controller" target="cls_service">

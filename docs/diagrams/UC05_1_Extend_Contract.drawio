          </mxGeometry>
        </mxCell>
        <mxCell id="6" value="2. Nhập ngày kết thúc mới (newEndDate)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;fontStyle=1;strokeColor=#182E3E;" edge="1" parent="1">

            <mxPoint x="370" y="185" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7" value="3. PUT /api/contracts/:id/extend (body: { endDate: newEndDate })" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;fontStyle=0;strokeColor=#182E3E;" edge="1" parent="1">

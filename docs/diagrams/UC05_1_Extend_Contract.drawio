        <mxCell id="5" value="1. Bấm nút &amp;quot;Gia hạn&amp;quot; tại hàng hợp đồng" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;fontStyle=1;strokeColor=#182E3E;" edge="1" parent="1">

        <mxCell id="guard_unpaid_debt" value="[hasUnpaidInvoices === true]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=2;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="140" y="360" width="260" height="20" as="geometry"/></mxCell>
        <mxCell id="guard_all_clear" value="[allInvoicesSettled === true]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=2;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="140" y="482" width="260" height="20" as="geometry"/></mxCell>
        <mxCell id="msg_0" value="select contract, input termination reason &amp; deposit refund amount" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.167;entryX=0;entryY=0.025;rounded=0;" edge="1" parent="1" source="bar_L_0" target="bar_UI_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_1" value="click &quot;Liquidate &amp; Terminate Contract&quot;" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.500;entryX=0;entryY=0.074;rounded=0;" edge="1" parent="1" source="bar_L_0" target="bar_UI_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_2" value="POST /api/contracts/:id/terminate (refundAmount, reason)" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.123;entryX=0;entryY=0.015;rounded=0;" edge="1" parent="1" source="bar_UI_0" target="bar_C_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_3" value="terminateContract(contractId, refundAmount, reason)" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.074;entryX=0;entryY=0.016;rounded=0;" edge="1" parent="1" source="bar_C_0" target="bar_S_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_4" value="db.invoices.find({ contractId, status: &#39;UNPAID&#39; })" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.090;entryX=0;entryY=0.071;rounded=0;" edge="1" parent="1" source="bar_S_0" target="bar_DB_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_5" value="unpaid invoice list" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.786;entryX=1;entryY=0.172;rounded=0;" edge="1" parent="1" source="bar_DB_0" target="bar_S_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_6" value="throw ConflictError(&quot;Cannot terminate: Outstanding unpaid invoices exist&quot;)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.295;entryX=1;entryY=0.324;rounded=0;" edge="1" parent="1" source="bar_S_0" target="bar_C_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_7" value="409 Conflict ({ success: false, message })" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.375;entryX=1;entryY=0.426;rounded=0;" edge="1" parent="1" source="bar_C_0" target="bar_UI_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_8" value="show debt settlement warning modal" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.463;entryX=1;entryY=0.990;rounded=0;" edge="1" parent="1" source="bar_UI_0" target="bar_L_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_9" value="db.contracts.updateOne({ _id: contractId }, { $set: { status: &#39;TERMINATED&#39; } })" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.557;entryX=0;entryY=0.010;rounded=0;" edge="1" parent="1" source="bar_S_0" target="bar_DB_1"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_10" value="contract set to TERMINATED" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.333;entryX=1;entryY=0.623;rounded=0;" edge="1" parent="1" source="bar_DB_1" target="bar_S_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_11" value="db.rooms.updateOne({ _id: roomId }, { $set: { status: &#39;AVAILABLE&#39; } })" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.672;entryX=0;entryY=0.583;rounded=0;" edge="1" parent="1" source="bar_S_0" target="bar_DB_1"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_12" value="room restored to AVAILABLE" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.833;entryX=1;entryY=0.721;rounded=0;" edge="1" parent="1" source="bar_DB_1" target="bar_S_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_13" value="termination receipt &amp; contract object" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.770;entryX=1;entryY=0.750;rounded=0;" edge="1" parent="1" source="bar_S_0" target="bar_C_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_14" value="200 OK ({ success: true, message: &quot;Contract liquidated&quot; })" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.794;entryX=1;entryY=0.778;rounded=0;" edge="1" parent="1" source="bar_C_0" target="bar_UI_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_15" value="refresh table: contract marked TERMINATED, room AVAILABLE" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.821;entryX=1;entryY=0.990;rounded=0;" edge="1" parent="1" source="bar_UI_0" target="bar_L_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>

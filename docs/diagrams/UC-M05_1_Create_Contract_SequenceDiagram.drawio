        <!-- Step 2 -->
        <mxCell id="msg_2" value="2: POST /api/contracts (roomId, tenantId, depositAmount, rentalPrice, startDate, endDate)" style="html=1;verticalAlign=bottom;rounded=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1">

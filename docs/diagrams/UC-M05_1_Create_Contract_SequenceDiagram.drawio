        <mxCell id="msg_5e" value="db.rooms.updateOne({ _id: roomId }, { $set: { status: &apos;RENTED&apos; } })" style="html=1;verticalAlign=bottom;rounded=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1">

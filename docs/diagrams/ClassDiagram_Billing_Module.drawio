        <mxCell id="rb1" value="uses" style="html=1;rounded=0;endArrow=open;endSize=12;" edge="1" parent="1" source="c_inv_ctrl" target="c_inv_srv"><mxGeometry relative="1" as="geometry"/></mxCell>

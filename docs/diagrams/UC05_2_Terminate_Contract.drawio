        <mxCell id="5" value="1. Bấm nút &amp;quot;Thanh lý&amp;quot; tại hàng hợp đồng mong muốn" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;fontStyle=1;strokeColor=#182E3E;" edge="1" parent="1">

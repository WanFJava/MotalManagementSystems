        </mxCell>
        <mxCell id="10" value="6a. Trả về 400 Bad Request (&amp;quot;Hợp đồng đã được thanh lý trước đó&amp;quot;)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;fontStyle=0;strokeColor=#4A6572;" edge="1" parent="1">

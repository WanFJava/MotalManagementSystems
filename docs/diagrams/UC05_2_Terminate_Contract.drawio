            <mxPoint x="90" y="150" as="sourcePoint" />
            <mxPoint x="315" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="6" value="2. Xác nhận hộp thoại: &amp;quot;Xác nhận thanh lý hợp đồng phòng?&amp;quot;" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;fontStyle=1;strokeColor=#182E3E;" edge="1" parent="1">

          </mxGeometry>
        </mxCell>
        <mxCell id="12" value="6b. Cập nhật contract.status = &amp;apos;TERMINATED&amp;apos; &amp;amp; save()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;fontStyle=0;strokeColor=#182E3E;" edge="1" parent="1">

            <mxPoint x="315" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7" value="3. PUT /api/contracts/:id/terminate" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;fontStyle=0;strokeColor=#182E3E;" edge="1" parent="1">

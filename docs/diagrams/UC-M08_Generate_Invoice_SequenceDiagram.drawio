        <mxCell id="msg_13" value="201 Created ({ success: true, count: N, data: invoiceList })" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.779;entryX=1;entryY=0.765;rounded=0;" edge="1" parent="1" source="bar_C_0" target="bar_UI_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>

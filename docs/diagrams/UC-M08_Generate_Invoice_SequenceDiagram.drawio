        <mxCell id="guard_no_util" value="[!utilityReading || missingMeter]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=2;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="140" y="360" width="260" height="20" as="geometry"/></mxCell>
        <mxCell id="guard_util_ok" value="[utilityReading exists &amp;&amp; contract.status === &#39;ACTIVE&#39;]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=2;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="140" y="482" width="350" height="20" as="geometry"/></mxCell>
        <mxCell id="msg_0" value="select billing month (e.g. 2026-11), click &quot;Generate Invoices&quot;" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.167;entryX=0;entryY=0.025;rounded=0;" edge="1" parent="1" source="bar_L_0" target="bar_UI_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_1" value="confirm batch generation" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.500;entryX=0;entryY=0.074;rounded=0;" edge="1" parent="1" source="bar_L_0" target="bar_UI_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_2" value="POST /api/invoices/generate (month: &quot;2026-11&quot;)" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.123;entryX=0;entryY=0.015;rounded=0;" edge="1" parent="1" source="bar_UI_0" target="bar_C_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_3" value="generateMonthlyInvoices(month)" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.074;entryX=0;entryY=0.016;rounded=0;" edge="1" parent="1" source="bar_C_0" target="bar_S_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_4" value="db.utilities.find({ month }) &amp; db.contracts.find({ status: &#39;ACTIVE&#39; })" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.090;entryX=0;entryY=0.071;rounded=0;" edge="1" parent="1" source="bar_S_0" target="bar_DB_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_5" value="active contracts &amp; utility records" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.786;entryX=1;entryY=0.172;rounded=0;" edge="1" parent="1" source="bar_DB_0" target="bar_S_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_6" value="throw BadRequestError(&quot;Cannot generate: Missing utility readings for month&quot;)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.295;entryX=1;entryY=0.324;rounded=0;" edge="1" parent="1" source="bar_S_0" target="bar_C_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_7" value="400 Bad Request ({ success: false, message })" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.375;entryX=1;entryY=0.426;rounded=0;" edge="1" parent="1" source="bar_C_0" target="bar_UI_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_8" value="show error popup: &quot;Please record electricity/water first&quot;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.463;entryX=1;entryY=0.990;rounded=0;" edge="1" parent="1" source="bar_UI_0" target="bar_L_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_9" value="calculateTotal(rent + elecUsage*3500 + waterUsage*25000 + wifi + garbage)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="bar_S_0" target="bar_S_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/><Array as="points"><mxPoint x="825" y="510"/><mxPoint x="825" y="535"/></Array><mxPoint x="801" y="510" as="sourcePoint"/><mxPoint x="801" y="535" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_10" value="db.invoices.insertMany(invoiceDocs)" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.574;entryX=0;entryY=0.143;rounded=0;" edge="1" parent="1" source="bar_S_0" target="bar_DB_1"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_11" value="inserted count result" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.929;entryX=1;entryY=0.664;rounded=0;" edge="1" parent="1" source="bar_DB_1" target="bar_S_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>

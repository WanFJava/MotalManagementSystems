        <mxCell id="msg_0" value="enter phone/email &amp; password" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.167;entryX=0;entryY=0.025;rounded=0;" edge="1" parent="1" source="bar_U_0" target="bar_UI_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_1" value="click &quot;Sign In&quot;" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.583;entryX=0;entryY=0.086;rounded=0;" edge="1" parent="1" source="bar_U_0" target="bar_UI_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_2" value="POST /api/auth/login (account, password)" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.136;entryX=0;entryY=0.015;rounded=0;" edge="1" parent="1" source="bar_UI_0" target="bar_C_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_3" value="authenticateUser(account, password)" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.074;entryX=0;entryY=0.016;rounded=0;" edge="1" parent="1" source="bar_C_0" target="bar_S_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_4" value="db.users.findOne({ $or: [{ phone: account }, { email: account }] })" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.090;entryX=0;entryY=0.071;rounded=0;" edge="1" parent="1" source="bar_S_0" target="bar_DB_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_5" value="user record (including passwordHash, role, status)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.786;entryX=1;entryY=0.172;rounded=0;" edge="1" parent="1" source="bar_DB_0" target="bar_S_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_6" value="bcrypt.compare(password, user.passwordHash)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="bar_S_0" target="bar_S_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/><Array as="points"><mxPoint x="825" y="350"/><mxPoint x="825" y="375"/></Array><mxPoint x="801" y="350" as="sourcePoint"/><mxPoint x="801" y="375" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_7" value="throw UnauthorizedError(&quot;Invalid credentials or locked account&quot;)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.328;entryX=1;entryY=0.353;rounded=0;" edge="1" parent="1" source="bar_S_0" target="bar_C_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_8" value="401 Unauthorized ({ success: false, message })" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.404;entryX=1;entryY=0.463;rounded=0;" edge="1" parent="1" source="bar_C_0" target="bar_UI_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_9" value="show error toast: &quot;Incorrect account or password&quot;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.506;entryX=1;entryY=0.990;rounded=0;" edge="1" parent="1" source="bar_UI_0" target="bar_U_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_10" value="jwt.sign({ userId: user._id, role: user.role })" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="bar_S_0" target="bar_S_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/><Array as="points"><mxPoint x="825" y="560"/><mxPoint x="825" y="585"/></Array><mxPoint x="801" y="560" as="sourcePoint"/><mxPoint x="801" y="585" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_11" value="{ user: sanitize(user), accessToken }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.689;entryX=1;entryY=0.676;rounded=0;" edge="1" parent="1" source="bar_S_0" target="bar_C_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_12" value="200 OK ({ success: true, token, user })" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.735;entryX=1;entryY=0.741;rounded=0;" edge="1" parent="1" source="bar_C_0" target="bar_UI_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_13" value="save token to AsyncStorage/localStorage &amp; route to Dashboard by role" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.802;entryX=1;entryY=0.990;rounded=0;" edge="1" parent="1" source="bar_UI_0" target="bar_U_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>

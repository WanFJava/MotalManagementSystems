        <mxCell id="msg_11" value="updated contract document" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.768;entryX=1;entryY=0.746;rounded=0;" edge="1" parent="1" source="bar_S_0" target="bar_C_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>

        <mxCell id="msg_0" value="select contract, pick new extension end date (+6 or +12 months)" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.167;entryX=0;entryY=0.026;rounded=0;" edge="1" parent="1" source="bar_L_0" target="bar_UI_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_1" value="click &quot;Confirm Extension&quot;" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.500;entryX=0;entryY=0.079;rounded=0;" edge="1" parent="1" source="bar_L_0" target="bar_UI_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_2" value="PUT /api/contracts/:id/extend (newEndDate, extensionTerms)" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.132;entryX=0;entryY=0.016;rounded=0;" edge="1" parent="1" source="bar_UI_0" target="bar_C_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_3" value="extendContractDuration(contractId, newEndDate)" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.079;entryX=0;entryY=0.018;rounded=0;" edge="1" parent="1" source="bar_C_0" target="bar_S_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_4" value="db.contracts.findById(contractId)" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.098;entryX=0;entryY=0.071;rounded=0;" edge="1" parent="1" source="bar_S_0" target="bar_DB_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_5" value="current contract document" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.786;entryX=1;entryY=0.188;rounded=0;" edge="1" parent="1" source="bar_DB_0" target="bar_S_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_6" value="throw BadRequestError(&quot;New end date must be after current expiration&quot;)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.321;entryX=1;entryY=0.349;rounded=0;" edge="1" parent="1" source="bar_S_0" target="bar_C_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_7" value="400 Bad Request ({ success: false, message })" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.405;entryX=1;entryY=0.454;rounded=0;" edge="1" parent="1" source="bar_C_0" target="bar_UI_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_8" value="show date picker error toast" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=0;exitY=0.493;entryX=1;entryY=0.990;rounded=0;" edge="1" parent="1" source="bar_UI_0" target="bar_L_0"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="msg_9" value="db.contracts.updateOne({ _id: contractId }, { $set: { endDate: newEndDate } })" style="html=1;verticalAlign=bottom;endArrow=block;exitX=1;exitY=0.589;entryX=0;entryY=0.010;rounded=0;" edge="1" parent="1" source="bar_S_0" target="bar_DB_1"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>

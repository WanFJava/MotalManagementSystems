        <mxCell id="guard_inv_date" value="[newEndDate &lt;= contract.endDate || contract.status !== &#39;ACTIVE&#39;]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=2;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="140" y="360" width="380" height="20" as="geometry"/></mxCell>

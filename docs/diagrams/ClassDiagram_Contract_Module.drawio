        <mxCell id="c_contract_ctrl" value="&lt;b&gt;&amp;lt;&amp;lt;Controller&amp;gt;&amp;gt;&lt;br&gt;ContractController&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- contractService: ContractService&lt;hr size=&quot;1&quot;/&gt;+ createContract(req, res): Promise&lt;void&gt;&lt;br&gt;+ signContract(req, res): Promise&lt;void&gt;&lt;br&gt;+ extendContract(req, res): Promise&lt;void&gt;&lt;br&gt;+ terminateContract(req, res): Promise&lt;void&gt;&lt;br&gt;+ getContractById(req, res): Promise&lt;void&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#dae8fc;strokeColor=#6c8ebf;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="280" height="230" as="geometry"/></mxCell>
        <mxCell id="c_contract_srv" value="&lt;b&gt;&amp;lt;&amp;lt;Service&amp;gt;&amp;gt;&lt;br&gt;ContractService&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- contractModel: Model&lt;IContract&gt;&lt;br&gt;- roomModel: Model&lt;IRoom&gt;&lt;hr size=&quot;1&quot;/&gt;+ createNewContract(dto: ContractDTO): Promise&lt;IContract&gt;&lt;br&gt;+ signDigitalContract(id, userId, sig): Promise&lt;IContract&gt;&lt;br&gt;+ extendContractDuration(id, newEndDate): Promise&lt;IContract&gt;&lt;br&gt;+ terminateAndRefund(id, refundAmount): Promise&lt;IContract&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#dae8fc;strokeColor=#6c8ebf;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="440" y="120" width="300" height="250" as="geometry"/></mxCell>
        <mxCell id="c_contract_model" value="&lt;b&gt;&amp;lt;&amp;lt;Entity/Model&amp;gt;&amp;gt;&lt;br&gt;RentalContract&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;+ _id: ObjectId&lt;br&gt;+ contractCode: string&lt;br&gt;+ roomId: ObjectId&lt;br&gt;+ tenantId: ObjectId&lt;br&gt;+ landlordId: ObjectId&lt;br&gt;+ depositAmount: number&lt;br&gt;+ rentalPrice: number&lt;br&gt;+ startDate: Date&lt;br&gt;+ endDate: Date&lt;br&gt;+ status: ContractStatus&lt;br&gt;+ signatureUrl: string&lt;br&gt;+ signedAt: Date&lt;hr size=&quot;1&quot;/&gt;+ isExpiringSoon(): boolean&lt;br&gt;+ canBeSignedBy(userId): boolean" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#dae8fc;strokeColor=#6c8ebf;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="840" y="100" width="300" height="320" as="geometry"/></mxCell>

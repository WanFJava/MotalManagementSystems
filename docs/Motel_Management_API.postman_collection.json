      "name": "1. Phân hệ Phòng (Room - Quang)",
      "item": [
        {
          "name": "GET Lấy danh sách phòng",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "http://localhost:5000/api/rooms", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "rooms"] }
          }
        },
        {
          "name": "GET Tìm kiếm & Lọc phòng",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "http://localhost:5000/api/rooms/search?status=AVAILABLE&minPrice=1000000&maxPrice=4000000", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "rooms", "search"], "query": [{ "key": "status", "value": "AVAILABLE" }, { "key": "minPrice", "value": "1000000" }, { "key": "maxPrice", "value": "4000000" }] }
          }
        },
        {
          "name": "POST Thêm phòng mới",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomNumber\": \"305\",\n  \"basePrice\": 3200000,\n  \"area\": 25,\n  \"maxOccupants\": 2,\n  \"amenities\": [\"Wifi\", \"Điều hòa\", \"Nóng lạnh\", \"Tủ lạnh\"],\n  \"status\": \"AVAILABLE\",\n  \"description\": \"Phòng mới xây có ban công thoáng mát\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/rooms", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "rooms"] }
          }
        }
      ]
    },
